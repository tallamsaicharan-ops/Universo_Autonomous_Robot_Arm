<?xml version="1.0"?>
<!--
  robot_arm.urdf : ROS 2 (Humble) version of the Onshape export "robotic_arm_cad.urdf".
  CAD GEOMETRY IS UNCHANGED: every mesh, mesh origin, inertial and CAD joint transform is copied verbatim.

  Changes vs. the Onshape export:
   1. Mesh paths  package://robotic_arm_cad/meshes/  ->  package://robot_arm/description/meshes/
   2. New base_link (REP-103: x forward, y left, z up; origin = bottom face of base block, on the yaw axis)
      and new base_joint (continuous yaw). The CAD has no turntable, so this joint is not in the export.
      Yaw axis passes through the centre of the base block (ra_5) - confirmed. Slip ring -> true continuous joint.
   3. The CAD root joint (fixed_node_to_root_joint, 0.18 / 0.49 deg alignment noise) is replaced by an
      exact rotation. Link "root" is removed.
   4. revolute_1 -> shoulder_joint, revolute_2 -> elbow_joint (same origins and axes as the CAD).
   5. Joint limits now come from the linear actuators (pin-to-pin 305 mm retracted .. 505 mm extended, datasheet).
      Datasheet stroke tolerance is +/-3 mm.
      Re-compute if the actuators or mount points change.
   6. <collision> added to every link (same mesh as visual) - required by MoveIt collision checking.
   7. New frame arm_tip = centre of the forearm extrusion end face (430.0 mm from elbow axis) = IK target.

  Joint conventions (zero = CAD export pose):
   base_joint     : + = counter-clockwise seen from above.
   shoulder_joint : 0 = upper arm vertical;  negative = leaning forward.  Upper-arm elevation = 90 deg + q.
   elbow_joint    : 0 = elbow inner angle 125.0 deg (forearm 35.0 deg above horizontal when upper arm is vertical); + = forearm folds down.
                    Forearm elevation = 35.0 deg + q_shoulder - q_elbow ; elbow inner angle = 125.0 deg - q_elbow.
  Link lengths: shoulder axis -> elbow axis = 540.0 mm ; elbow axis -> arm_tip = 430.0 mm.
  Shoulder axis is 92.5 mm in front of the base-block origin and 20.0 mm above its bottom face.
-->
<robot name="robot_arm">

  <!-- ===================== NEW: base frames and base yaw joint ===================== -->
  <link name="base_link"/>

  <joint name="base_joint" type="continuous">
    <parent link="base_link"/>
    <child link="base_yaw_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- RMCS-5029: 70 kgcm rated = 6.86 N m, 30 rpm at output = 3.14 rad/s (if direct drive) -->
    <limit effort="6.86" velocity="3.14"/>
  </joint>

  <link name="base_yaw_link"/>

  <joint name="base_yaw_to_base_block" type="fixed">
    <parent link="base_yaw_link"/>
    <child link="ra_5__boss_extrude4"/>
    <!-- yaw axis assumed at base-block centre (part x = -0.005) -> part origin is 5.0 mm forward -->
    <origin xyz="0.005 0 0" rpy="1.570796326794897 0 0"/>
  </joint>

  <!-- ===================== CAD links (unchanged geometry, collision added) ===================== -->
  <link name="3030_extrusion_robotic_arm_l1__boss_extrude1">
    <inertial>
      <mass value="0.387141"/>
      <origin xyz="-0.0150005 -0.179999 -0.0149899" rpy="0 -0 0"/>
      <inertia ixx="0.00809803" ixy="4.1151e-10" ixz="5.45636e-11" iyy="6.52627e-05" iyz="3.62357e-10" izz="0.00809803"/>
    </inertial>
    <visual>
      <origin xyz="-0.0150005 0.0200024 -0.0149897" rpy="0 -0 0"/>
      <geometry><mesh filename="package://robot_arm/description/meshes/_3030_extrusion_robotic_arm_L1__Boss_Extrude1.stl" scale="1 1 1"/></geometry>
      <material name="cad_grey"><color rgba="0.792157 0.819608 0.933333 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.0150005 0.0200024 -0.0149897" rpy="0 -0 0"/>
      <geometry><mesh filename="package://robot_arm/description/meshes/_3030_extrusion_robotic_arm_L1__Boss_Extrude1.stl" scale="1 1 1"/></geometry>
    </collision>
  </link>

