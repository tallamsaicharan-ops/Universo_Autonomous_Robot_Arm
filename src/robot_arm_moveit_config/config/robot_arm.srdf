<?xml version="1.0" encoding="UTF-8"?>
<!-- SRDF for robot_arm (3-DOF arm: base_joint, shoulder_joint, elbow_joint). Gripper is manual -> no end effector group.
     Collision matrix computed from the URDF meshes over 10000 random poses inside the joint limits:
     no link pair can self-collide within limits, so every pair is disabled (same result Setup Assistant gives).
     Environment collisions (rover deck, ground, objects) are still checked once added to the planning scene. -->
<robot name="robot_arm">
    <group name="arm">
        <chain base_link="base_link" tip_link="arm_tip"/>
    </group>

    <!-- home  = both actuators fully retracted (folded, safe rest pose) -->
    <group_state name="home" group="arm">
        <joint name="base_joint" value="0"/>
        <joint name="shoulder_joint" value="-0.06"/>
        <joint name="elbow_joint" value="0.97"/>
    </group_state>
    <!-- ready = upper arm 60 deg above horizontal, elbow inner angle 110 deg -->
    <group_state name="ready" group="arm">
        <joint name="base_joint" value="0"/>
        <joint name="shoulder_joint" value="-0.5236"/>
        <joint name="elbow_joint" value="0.2618"/>
    </group_state>

    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="3030_extrusion_robotic_arm_l1__boss_extrude1_1" reason="Never"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="3030_extrusion_robotic_arm_l2__boss_extrude1" reason="Never"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_1__cut_extrude1" reason="Never"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_1__cut_extrude1_1" reason="Never"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_1__cut_extrude1_2" reason="Adjacent"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_1__cut_extrude1_3" reason="Adjacent"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_1__cut_extrude1_4" reason="Never"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_1__cut_extrude1_5" reason="Never"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_3__boss_extrude1" reason="Never"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_3__boss_extrude1_1" reason="Never"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_4__cut_extrude1" reason="Never"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_4__cut_extrude1_1" reason="Default"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_4__cut_extrude1_2" reason="Never"/>
    <disable_collisions link1="3030_extrusion_robotic_arm_l1__boss_extrude1" link2="ra_5__boss_extrude4" reason="Never"/>
