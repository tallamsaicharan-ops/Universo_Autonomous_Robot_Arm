<?xml version="1.0"?>
<!-- Gazebo Classic test world: ground, light, a table in reach with two target cubes.
     Arm base_link sits on the 0.40 m pedestal at the origin; +x is the arm's forward direction. -->
<sdf version="1.6">
  <world name="arm_test">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="table">
      <static>true</static>
      <pose>0.75 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.30 0.50 0.30</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.30 0.50 0.30</size></box></geometry>
          <material><ambient>0.55 0.40 0.25 1</ambient><diffuse>0.55 0.40 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="target_red">
      <pose>0.70 0.12 0.32 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.3e-5</ixx><iyy>1.3e-5</iyy><izz>1.3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="target_blue">
      <pose>0.80 -0.12 0.32 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.3e-5</ixx><iyy>1.3e-5</iyy><izz>1.3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
